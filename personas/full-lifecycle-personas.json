          "flag churn risk",
          "run outcome-focused reviews"
        ],
        "outputs": [
          "onboarding playbook",
          "health model",
          "expansion plan"
        ],
        "handoff_to": [
          "growth-marketer",
          "product-manager",
          "customer-support-analyst"
        ]
      }
    },
    {
      "id": "reviewer-agent",
      "phase": "quality-gate",
      "goal": "Provide adversarial implementation review before merge.",
      "prompt": "You are the Reviewer Agent. Review proposed changes for correctness, edge-case handling, reliability, and security implications. Mark blocking vs non-blocking findings clearly.",
      "agent_instructions": {
        "inputs": [
          "PR diff",
          "acceptance criteria",
          "test results"
        ],
        "workflow_steps": [
          "validate requirements coverage",
          "inspect risky paths",
          "classify findings",
          "verify fixes"
        ],
        "outputs": [
          "review findings",
          "merge recommendation",
          "follow-up checks"
        ],
        "guardrails": [
          "no style-only noise",
          "block merge on correctness/security defects"
        ],
        "handoff_to": [
          "release-manager",
          "backend-engineer",
          "frontend-engineer"
        ]
      }
    }
  ],
  "process_flow": {
    "name": "issue-swarm-orchestration",
    "objective": "Run personas in strict stage order while maximizing safe parallel execution within each stage.",
    "scheduling_model": {
      "inter_stage": "sequential",
      "intra_stage": "parallel-when-independent",
      "dependency_rule": "A persona may start only when all declared upstream personas for its stage/lane are complete or explicitly waived by program-manager.",
      "priority_rule": "Program-manager dispatches issues by executive priority, then urgency, then dependency depth."
    },
    "issue_lifecycle_labels": {
      "intake": [
        "swarm:intake"
      ],
      "ready": [
        "swarm:ready"
      ],
      "active": [
        "swarm:active"
      ],
      "blocked": [
        "swarm:blocked",
        "needs:decision"
      ],
      "quality_gate": [
        "swarm:quality-gate"
      ],
      "complete": [
        "swarm:complete",
        "release:ready"
      ]
    },
    "stages": [
      {
        "stage": 0,
        "name": "executive-direction",
        "mode": "parallel",
        "personas": [
          "ceo-strategy-lead",
          "cpo-product-strategy",
          "cto-platform-strategist",
          "cfo-portfolio-manager"
        ],
        "exit_criteria": [
          "strategy memo published",
          "priority themes ranked",
          "budget and capacity guardrails set"
        ]
      },
      {
        "stage": 1,
        "name": "program-intake-triage",
        "mode": "sequential",
        "personas": [
          "program-manager"
        ],
        "actions": [
          "normalize issue",
          "apply priority and type labels",
          "set dependencies",
          "mark swarm:ready when executable"
        ],
        "exit_criteria": [
          "acceptance criteria explicit",
          "dependencies mapped",
          "ready labels applied"
        ]
      },
      {
        "stage": 2,
        "name": "discovery-and-definition",
        "mode": "parallel",
        "lanes": [
          {
            "lane": "problem-definition",
            "personas": [
              "vision-strategist",
              "market-research-analyst",
              "product-manager"
            ]
          },
          {
            "lane": "user-definition",
            "personas": [
              "ux-researcher",
              "ux-designer"
            ]
          },
          {
            "lane": "solution-definition",
            "personas": [
              "solution-architect",
              "technical-lead"
            ]
          }
        ],
        "exit_criteria": [
          "PRD-lite approved",
          "UX + architecture handoff complete",
          "implementation slices defined"
        ]
      },
      {
        "stage": 3,
        "name": "implementation-swarm",
        "mode": "parallel",
        "personas": [
          "backend-engineer",
          "frontend-engineer",
          "data-engineer"
        ],
        "coordination": [
          "program-manager assigns parallel issues by dependency graph",
          "technical-lead arbitrates cross-lane conflicts"
        ],
        "exit_criteria": [
          "code complete",
          "tests authored for changed areas",
          "security pre-check ready"
        ]
      },
      {
        "stage": 4,
        "name": "quality-and-risk-gates",
        "mode": "parallel",
        "personas": [
          "security-engineer",
          "privacy-compliance-officer",
          "qa-lead",
          "test-automation-engineer",
          "performance-engineer",
          "reviewer-agent"
        ],
        "exit_criteria": [
          "no unresolved blocking findings",
          "test gates passed",
          "compliance/security sign-off recorded"
        ]
      },
      {
        "stage": 5,
        "name": "delivery-and-release",
        "mode": "sequential",
        "personas": [
          "devops-engineer",
          "release-manager"
        ],
        "exit_criteria": [
          "deployment successful",
          "rollback verified",
          "release notes published"
        ]
      },
      {
        "stage": 6,
        "name": "operations-and-growth",
        "mode": "parallel",
        "personas": [
          "site-reliability-engineer",
          "customer-support-analyst",
          "product-marketing-manager",
          "content-marketer",
          "growth-marketer",
          "sales-engineer",
          "customer-success-manager"
        ],
        "exit_criteria": [
          "post-release health green",
          "customer feedback loop active",
          "growth experiments queued"
        ]
      }
    ],
    "completion_protocol": {
      "owner": "program-manager",
      "required_evidence": [
        "linked PR/tests",
        "review result",
        "security/compliance result",
        "release status"
      ],
      "on_pass": [
        "apply swarm:complete",
        "apply release:ready when applicable",
        "close or transition issue"
      ],
      "on_fail": [
        "apply swarm:blocked",
        "apply needs:decision when exec input required",
        "re-queue at correct stage"
      ]
    }
  },
  "pr_review_flow": {
    "name": "pr-review-dual-control",
    "objective": "Run parallel PR review swarm while enforcing dual-control merge approval from solution-architect and program-manager only.",
    "roles": {
      "advisory_reviewers": [
        "reviewer-agent",
        "security-engineer",
        "privacy-compliance-officer",
        "qa-lead",
        "test-automation-engineer",
        "performance-engineer",
        "devops-engineer",
        "site-reliability-engineer"
      ],
      "required_signoff": [
        "solution-architect",
        "program-manager"
      ],
      "merge_authority": [
        "solution-architect",
        "program-manager"
      ]
    },
    "rules": [
      "PR enters review with label pr:in-review and swarm:quality-gate.",
      "Advisory reviewers run in parallel and publish findings as blocking/non-blocking.",
      "Any unresolved blocking finding prevents sign-off.",
      "Only solution-architect and program-manager can issue final approvals.",
      "Merge is permitted only when BOTH required_signoff roles approve.",
      "No other persona may merge, even if all checks pass.",
      "If architect and program-manager disagree, label needs:decision and escalate to executive strategy personas."
    ],
    "states": [
      {
        "state": "pr:in-review",
        "entry": [
          "open PR",
          "attach issue link",
          "attach test/security evidence"
        ],
        "exit": [
          "all advisory reviews completed"
        ]
      },
      {
        "state": "pr:changes-requested",
        "entry": [
          "one or more blocking findings"
        ],
        "exit": [
          "blocking findings resolved and re-reviewed"
        ]
      },
      {
        "state": "pr:awaiting-signoff",
        "entry": [
          "no unresolved blocking findings"
        ],
        "exit": [
          "architect approved",
          "program-manager approved"
        ]
      },
      {
        "state": "pr:approved",
        "entry": [
          "dual approval recorded"
        ],
        "exit": [
          "merged by architect or program-manager"
        ]
      },
      {
        "state": "pr:merged",
        "entry": [
          "merge executed by authorized role"
        ],
        "exit": []
      }
    ],
    "evidence_requirements": [
      "linked issue and acceptance criteria",
      "test results summary",
      "security/compliance review outcome",
      "architecture impact note",
      "rollback or mitigation note for risky changes"
    ],
    "enforcement_controls": {
      "required_labels_before_merge": [
        "pr:approved"
      ],
      "required_approvals": {
        "solution-architect": 1,
        "program-manager": 1
      },
      "forbidden_mergers": [
        "backend-engineer",
        "frontend-engineer",
        "reviewer-agent",
        "release-manager",
        "devops-engineer"
      ]
    },
    "program_manager_actions": {
      "on_dual_approval": [
        "apply pr:approved",
        "apply merge:authorized"
      ],
      "on_merge": [
        "apply pr:merged",
        "update linked issue to swarm:complete when criteria met"
      ]
    }
  }
}
